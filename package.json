{
  "name": "mcp-immo-olv",
  "version": "0.5.0",
  "description": "French real-estate intelligence MCP: notarized sale prices (DVF), transparent comparables valuations, official rent indicators, average property-tax context, DPE, natural risks and commune data. No API keys.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-immo-olv": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "immobilier",
    "france",
    "dvf",
    "taxe-fonciere",
    "dpe",
    "georisques",
    "real-estate",
    "open-data",
    "ban",
    "adresse",
    "olivier-lavaud"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "author": "Olivier LAVAUD"
}
